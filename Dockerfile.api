FROM node:24-bookworm-slim

# ── PDF → Markdown 변환 ──
# poppler-utils: pdftotext / pandoc: 문서 변환
RUN apt-get update && apt-get install -y --no-install-recommends \
    poppler-utils \
    pandoc \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY server/package.json ./
RUN npm install --legacy-peer-deps \
    && npm rebuild better-sqlite3 # ABI 일치 보장 (캐시된 레이어 재사용 대비)

COPY server/ ./
# Practice 모드 @uses 주입용 코어 라이브러리 (src/lib → /app/src/lib)
COPY src/lib ./src/lib

EXPOSE 3001
CMD ["node", "index.js"]
