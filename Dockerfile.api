FROM node:24-bookworm-slim

# ── PDF → Markdown 변환 + 문서 스캐너 (LiteObject/doc-scanner — 스크립트 vendor) ──
# poppler-utils: pdftotext / pandoc: 문서 변환
# libgl1·libglib2.0-0: opencv-python(GUI 빌드) 실행 라이브러리
RUN apt-get update && apt-get install -y --no-install-recommends \
    poppler-utils \
    pandoc \
    python3 \
    python3-pip \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY server/package.json ./
RUN npm install --legacy-peer-deps \
    && npm rebuild better-sqlite3 # ABI 일치 보장 (캐시된 레이어 재사용 대비)

# ── Python 의존성 — requirements 파일이 바뀔 때만 재설치 ──
# (COPY server/ ./ 보다 앞에 둬야 코드 수정으로 pip 캐시가 깨지지 않음)
COPY server/requirements-scan.txt ./
RUN pip3 install --break-system-packages --no-cache-dir -r requirements-scan.txt

COPY server/ ./

EXPOSE 3001
CMD ["node", "index.js"]
